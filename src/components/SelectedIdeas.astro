---
const ideas = [
  { type:'WRITING · AI + MARKETING', title:'AI should improve the marketing system, not just accelerate tasks', description:'Where AI can create real leverage across the marketing organization — and where simply doing the same work faster misses the bigger opportunity.', cta:'Read →', style:'rings' },
  { type:'FRAMEWORK · MARKETING ENGINES', title:'What makes a B2B marketing engine work?', description:'A practical way to think about the systems, capabilities, and operating rhythms that turn marketing activity into sustainable growth.', cta:'Explore →', style:'grid' },
  { type:'EXPERIMENT · GROWTH SYSTEMS', title:'Marketing Engine Diagnostic', description:'An experiment in identifying where a B2B marketing organization is strong, where friction exists, and what to improve next.', cta:'Try it →', style:'flow' }
];
---
<section class="section section-alt">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">Ideas</p>
      <h2>Selected ideas</h2>
      <p>A mix of writing, frameworks, and experiments around B2B growth, AI, and marketing operations.</p>
    </div>
    <div class="ideas-grid">
      {ideas.map((idea) => (
        <article class="idea-card">
          <div class:list={['visual', idea.style]} aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="idea-body">
            <p class="idea-type">{idea.type}</p>
            <h3>{idea.title}</h3>
            <p>{idea.description}</p>
            <a class="text-link" href="/ideas">{idea.cta}</a>
          </div>
        </article>
      ))}
    </div>
    <div class="all-link"><a class="text-link" href="/ideas">View all ideas <span class="arrow">→</span></a></div>
  </div>
</section>
<style>
.ideas-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.idea-card { background:var(--white); border:1px solid rgba(18,58,55,.10); border-radius:var(--radius-md); overflow:hidden; transition:transform .22s ease,border-color .22s ease; }
.idea-card:hover { transform:translateY(-5px); border-color:rgba(18,58,55,.24); }
.visual { height:180px; position:relative; overflow:hidden; background:var(--shell); }
.rings span { position:absolute; border:18px solid var(--ocean-teal); border-radius:50%; width:130px; height:130px; top:20px; left:34px; opacity:.92; }
.rings span:nth-child(2){ left:116px; top:42px; border-color:var(--soft-coral); }
.rings span:nth-child(3){ width:44px;height:44px;left:218px;top:66px;border:0;background:var(--signal-coral); }
.grid { background-image:linear-gradient(rgba(18,58,55,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(18,58,55,.08) 1px,transparent 1px); background-size:28px 28px; }
.grid span { position:absolute; width:62px;height:62px;background:var(--deep-ink);border-radius:12px;left:46px;top:58px; }
.grid span:nth-child(2){left:126px;top:30px;background:var(--sea-glass)} .grid span:nth-child(3){left:208px;top:74px;background:var(--digital-blue)}
.flow span { position:absolute; width:68px;height:68px;border-radius:50%; background:var(--sea-glass); left:36px; top:68px; }
.flow span:nth-child(2){ left:154px; top:36px; background:var(--signal-coral); } .flow span:nth-child(3){ left:246px; top:86px; background:var(--digital-blue); }
.flow::after { content:"";position:absolute;left:86px;top:84px;width:188px;height:60px;border-top:4px solid var(--deep-ink);border-radius:50%;transform:rotate(-5deg); }
.idea-body { padding:24px; }
.idea-type { font-size:.72rem; letter-spacing:.12em; font-weight:900; color:var(--ocean-teal); }
.idea-card h3 { min-height:78px; }
.all-link { margin-top:34px; }
@media (max-width: 980px) { .ideas-grid { grid-template-columns:repeat(2,1fr); } .idea-card:last-child { grid-column:1 / -1; max-width:calc(50% - 11px); } }
@media (max-width: 680px) { .ideas-grid { grid-template-columns:1fr; } .idea-card:last-child { grid-column:auto; max-width:none; } }
</style>
