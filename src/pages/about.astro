---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const LINKEDIN_URL = 'https://www.linkedin.com/in/heidivandermeer';

---

<BaseLayout
  title="About Heidi Vandermeer | B2B Marketing & Growth Leadership"
  description="B2B marketing leader focused on growth systems, demand generation, ABM, AI in GTM, and modern marketing leadership."
  canonical="https://heidivandermeer.com/about"
>
  <Header />
  <main>
    <section class="about-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">About</p>
          <h1>Hello!</h1>
          <p class="hero-lede">I’m Heidi, a B2B marketing leader focused on building stronger growth engines, better marketing systems, and teams that operate with real impact.</p>
        </div>
        <div class="portrait-composition">
          <div class="portrait-accent portrait-accent--coral" aria-hidden="true"></div>
          <div class="portrait-accent portrait-accent--teal" aria-hidden="true"></div>
          <figure class="portrait-frame">
            <img src="/images/heidi-portrait.png" alt="Portrait of Heidi Vandermeer" />
        </div>
      </div>
    </section>

    <section class="narrative-section" aria-labelledby="story-heading">
      <div class="container narrative-grid">
        <p class="eyebrow" aria-hidden="true">Summary</p>
        <div class="narrative-copy">
          <p>I’ve spent my career in B2B organizations across growth functions including demand generation, ABM, digital, marketing operations, and sales alignment. Most recently, I’ve led demand generation at Resolver and within Kroll, working at the intersection of growth strategy, execution, team leadership, and AI in GTM.</p>
          <p>The best marketing organizations aren’t just campaigns and activities. They’re systems that get the people, process and technology right. What interests me most is how the whole system works together to drive growth.</p>
        </div>
      </div>
    </section>

    <section class="experience-section" aria-labelledby="experience-heading">
      <div class="container experience-layout">
        <div class="experience-intro">
          <p class="eyebrow">Experience</p>
          <h2 id="experience-heading">Places I've grown</h2>
        </div>

        <div class="experience-list">
          <article class="experience-item">
            <h3 class="company-name">Resolver, a Kroll business</h3>
            <div class="role">
              <div class="role-heading">
                <h4>VP, Demand Generation</h4>
                <p class="role-date">March – Present</p>
              </div>
            </div>
            <div class="role">
              <div class="role-heading">
                <h4>Director, Demand Generation</h4>
                <p class="role-date">Oct 2021 – Feb 2026</p>
              </div>
              <div class="role-copy">
                <p>Lead demand generation and growth marketing across four business lines. Resolver has grown several times since I joined, including being acquired and merging with another org. I've had the chance to build out teams and programs across web, paid, ABM, content, events, SEO, with multi-channel campaigns.</p>
                <p>Took a leading role with implementing AI over multiple years.</p>
              </div>
            </div>
            <div class="milestones" aria-label="Resolver milestones">
              <span class="milestone">Acquired by Kroll · 2022</span>
            </div>
          </article>

          <article class="experience-item">
            <h3 class="company-name">Security Compass</h3>
            <div class="role">
              <div class="role-heading">
                <h4>Manager, Demand Generation</h4>
                <p class="role-date">May 2019 – Oct 2021</p>
              </div>
              <div class="role-copy">
                <p>Led demand generation for both software and services businesses. Worked closely with sales to build out the growth engine, which included ABM, paid ads, events, webinars, digital programs, and the reporting + systems behind it. Also experienced the company going through a major outside investment.</p>
              </div>
            </div>
            <div class="milestones" aria-label="Security Compass milestones">
              <span class="milestone">First institutional funding · FTV Capital</span>
            </div>
          </article>

          <article class="experience-item">
            <h3 class="company-name">Uberflip</h3>
            <div class="role">
              <div class="role-heading">
                <h4>Account-Based Marketing</h4>
                <p class="role-date">May 2017 – May 2019</p>
              </div>
              <div class="role-copy">
                <p>Built Uberflip's account-based marketing program, with multiple levels of scale and personalization. Lots of experimentation with personalized web experiences, direct mail, ads, events, chatbots, and content to create multi-channel ABM campaigns.</p>
                <p>One of those programs ended up winning an ABMie Award for "Best ABM Campaign at Scale".</p>
              </div>
            </div>
            <div class="milestones" aria-label="Uberflip milestones">
              <span class="milestone milestone--award">ABMie Award · Best ABM Campaign at Scale</span>
              <span class="milestone">First major funding round · Updata Partners</span>
            </div>
            <div class="role role--earlier">
              <p class="earlier-label">Earlier role at Uberflip</p>
              <div class="role-heading">
                <h4>Enterprise Customer Business Development</h4>
                <p class="role-date">Mar 2016 – May 2017</p>
              </div>
              <div class="role-copy">
                <p>Created a new enterprise expansion motion for larger customers.</p>
              </div>
            </div>
          </article>

          <article class="experience-item">
            <h3 class="company-name">Kira Talent</h3>
            <div class="role">
              <div class="role-heading">
                <h4>Growth &amp; Sales</h4>
                <p class="role-date">Oct 2014 – Feb 2016</p>
              </div>
              <div class="role-copy">
                <p>Joined Kira Talent as an early employee and worked across sales, growth, market research, and a few go-to-market experiments as we expanded into new markets.</p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="connect-section" aria-labelledby="connect-heading">
      <div class="container connect-grid">
        <p class="eyebrow">Connect</p>
        <div>
          <h2 id="connect-heading">Want to talk?</h2>
          <a class="btn btn-primary" href={LINKEDIN_URL} target="_blank" rel="noreferrer" aria-label="Connect with Heidi Vandermeer on LinkedIn (opens in a new tab)">Connect on LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-hero { padding: clamp(4.5rem, 10vw, 8.5rem) 0 clamp(5rem, 11vw, 9rem); overflow: hidden; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr); gap:clamp(3rem,7vw,7rem); align-items:center; }
  .hero-copy h1 { max-width:730px; margin-bottom:2rem; }
  .hero-lede { max-width:680px; color:var(--deep-ink); font-size:clamp(1.2rem,2vw,1.48rem); line-height:1.55; }
  .portrait-composition { position:relative; padding:2rem 1.7rem 1.6rem 2.4rem; }
  .portrait-frame { position:relative; z-index:2; margin:0; aspect-ratio:4/5; overflow:hidden; border-radius:190px 190px 24px 24px; background:var(--mist); }
  .portrait-frame img { width:100%; height:100%; object-fit:cover; object-position:center top; }
  .portrait-accent { position:absolute; z-index:1; }
  .portrait-accent--coral { width:48%; aspect-ratio:1; top:0; right:0; border-radius:50%; background:var(--soft-coral); }
  .portrait-accent--teal { width:38%; height:34%; left:0; bottom:0; background:var(--ocean-teal); border-radius:0 0 0 70px; }
  .narrative-section { padding:clamp(5rem,10vw,9rem) 0; border-block:1px solid rgba(18,58,55,.11); }
  .narrative-grid { display:grid; grid-template-columns:1fr 3fr; gap:3rem; }
  .section-marker { color:var(--signal-coral); font-weight:800; letter-spacing:.12em; }
  .narrative-copy { max-width:850px; }
  .narrative-copy p { font-size:clamp(1.08rem,1.6vw,1.28rem); line-height:1.8; }
  .narrative-copy .opening { color:var(--deep-ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.55rem,3vw,2.35rem); line-height:1.38; }
  .topics-section { padding:clamp(5rem,10vw,9rem) 0; }
  .topics-intro { max-width:720px; margin-bottom:3.5rem; }
  .topics-intro h2 { margin-bottom:1.4rem; }
  .topics-intro > p:last-child { font-size:1.12rem; }
  .topic-grid { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid rgba(18,58,55,.18); }
  .topic-grid li { min-height:190px; padding:1.6rem 2rem 2rem 0; border-bottom:1px solid rgba(18,58,55,.18); display:grid; grid-template-columns:52px 1fr; gap:1.2rem; }
  .topic-grid li:nth-child(odd) { border-right:1px solid rgba(18,58,55,.18); }
  .topic-grid li:nth-child(even) { padding-left:2rem; }
  .topic-grid span { color:var(--ocean-teal); font-size:.75rem; font-weight:800; letter-spacing:.12em; }
  .topic-grid p { color:var(--deep-ink); font-size:clamp(1.08rem,1.8vw,1.35rem); line-height:1.45; }
  .editorial-note { max-width:800px; margin:3.5rem 0 0 auto; padding-left:1.5rem; border-left:4px solid var(--signal-coral); color:var(--deep-ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.25rem,2.5vw,1.7rem); }
  .editorial-note em { color:var(--ocean-teal); }
  .personal-section { padding:clamp(5rem,10vw,8rem) 0; background:var(--mist); }
  .personal-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(3rem,8vw,8rem); }
  .personal-heading h2 { max-width:520px; }
  .personal-copy { max-width:690px; padding-top:2.5rem; }
  .personal-copy > p { font-size:clamp(1.05rem,1.6vw,1.2rem); }
  .interest-labels { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:2.4rem; }
  .interest-labels span { padding:.55rem .8rem; border:1px solid rgba(18,58,55,.22); border-radius:999px; color:var(--deep-ink); font-size:.7rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .personal-graphic { width:180px; height:90px; margin-top:3rem; display:flex; align-items:flex-end; gap:10px; }
  .personal-graphic span { display:block; width:48px; background:var(--ocean-teal); }
  .personal-graphic span:nth-child(1) { height:42px; border-radius:50% 50% 0 0; }
  .personal-graphic span:nth-child(2) { height:74px; background:var(--signal-coral); }
  .personal-graphic span:nth-child(3) { height:58px; background:var(--digital-blue); border-radius:0 28px 0 0; }
  .experience-section { padding:clamp(5rem,10vw,9rem) 0; background:var(--mist); }
  .experience-layout { display:grid; grid-template-columns:minmax(220px,.8fr) minmax(0,2.2fr); gap:clamp(3rem,8vw,7rem); align-items:start; }
  .experience-intro { position:sticky; top:120px; }
  .experience-intro h2 { max-width:440px; font-size:clamp(2.2rem,4vw,3.5rem); }
  .experience-list { max-width:820px; }
  .experience-item { position:relative; padding:0 0 clamp(4rem,7vw,6rem) 2rem; border-left:1px solid rgba(18,58,55,.2); }
  .experience-item:last-child { padding-bottom:0; }
  .experience-item::before { content:""; position:absolute; top:.4rem; left:-5px; width:9px; height:9px; border-radius:50%; background:var(--ocean-teal); box-shadow:0 0 0 6px var(--mist); }
  .company-name { margin-bottom:1.4rem; color:var(--ocean-teal); font-size:.82rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .role + .role { margin-top:1.8rem; }
  .role-heading { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:1.5rem; align-items:baseline; margin-bottom:1rem; }
  .role-heading h4 { margin:0; color:var(--deep-ink); font-size:clamp(1.35rem,2.3vw,1.85rem); line-height:1.2; letter-spacing:-.02em; }
  .role-date { margin:0; color:var(--slate); font-family:var(--font-sans); font-size:.82rem; font-weight:600; letter-spacing:.02em; white-space:nowrap; }
  .role-copy { max-width:690px; }
  .role-copy p { font-size:1.02rem; line-height:1.75; }
  .milestones { display:flex; flex-wrap:wrap; gap:.65rem; margin-top:1.5rem; }
  .milestone { display:inline-flex; align-items:center; min-height:34px; padding:.4rem .7rem; border-radius:8px; background:color-mix(in srgb,var(--sea-glass) 30%,var(--white)); color:var(--deep-ink); font-size:.78rem; font-weight:700; line-height:1.35; }
  .milestone--award { background:var(--soft-coral); }
  .role--earlier { margin-top:2.5rem; padding-top:2rem; border-top:1px solid rgba(18,58,55,.16); }
  .earlier-label { margin-bottom:.8rem; color:var(--ocean-teal); font-family:var(--font-sans); font-size:.74rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .connect-section { padding:clamp(5rem,10vw,8rem) 0; background:var(--deep-ink); }
  .connect-grid { display:grid; grid-template-columns:1fr 3fr; gap:3rem; }
  .connect-section .eyebrow { color:var(--sea-glass); }
  .connect-section h2 { max-width:850px; margin-bottom:2.2rem; color:var(--white); font-size:clamp(2rem,4vw,3.4rem); }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media (max-width:900px) { .hero-grid,.personal-grid,.experience-layout { grid-template-columns:1fr; } .portrait-composition { width:min(100%,600px); } .narrative-grid,.connect-grid { grid-template-columns:1fr; gap:1.25rem; } .personal-copy { padding-top:0; } .experience-intro { position:static; } .experience-list { max-width:none; } }
  @media (max-width:640px) { .about-hero { padding-top:4rem; } .portrait-composition { padding:1.2rem .9rem 1rem 1.2rem; } .experience-item { padding-left:1.25rem; } .role-heading { grid-template-columns:1fr; gap:.35rem; } .role-date { white-space:normal; } .topic-grid { grid-template-columns:1fr; } .topic-grid li,.topic-grid li:nth-child(even) { min-height:0; padding:1.5rem 0; border-right:0; } }
</style>
