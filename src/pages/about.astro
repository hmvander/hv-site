---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const LINKEDIN_URL = 'https://www.linkedin.com/in/heidivandermeer';

---

<BaseLayout
  title="About Heidi Vandermeer | B2B Marketing & Growth Leadership"
  description="B2B marketing leader focused on growth systems, demand generation, AI in GTM, and modern marketing leadership."
  canonical="https://heidivandermeer.com/about"
>
  <Header />
  <main>
    <section class="about-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">About</p>
          <h1>Hello <span aria-hidden="true">👋</span></h1>
          <p class="hero-lede">I’m Heidi, a B2B marketing leader focused on building stronger growth engines, better marketing systems, and teams that operate with real impact.</p>
        </div>
        <div class="portrait-composition">
          <figure class="portrait-frame">
            <img
              src="/images/heidi-editorial-portrait.png"
              alt="Portrait of Heidi Vandermeer"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="narrative-section" aria-labelledby="story-heading">
      <div class="container narrative-grid">
        <p class="section-marker" aria-hidden="true">01</p>
        <div class="narrative-copy">
          <p>I’ve spent my career in B2B organizations across growth functions including demand generation, ABM, digital, marketing operations, and sales alignment. Most recently, I’ve led demand generation at Resolver and within Kroll, working at the intersection of growth strategy, execution, team leadership, and AI in GTM.</p>
          <p>The best marketing organizations aren’t collections of campaigns. They’re systems that get the people, process and technology right. What interests me most isn’t any one channel or tactic. It’s how the whole system works together.</p>
        </div>
      </div>
    </section>

    <section class="connect-section" aria-labelledby="connect-heading">
      <div class="container connect-grid">
        <p class="eyebrow">Connect</p>
        <div>
          <h2 id="connect-heading">If you’re thinking about similar questions, I’d be glad to connect.</h2>
          <a class="btn btn-primary" href={LINKEDIN_URL} target="_blank" rel="noreferrer" aria-label="Connect with Heidi Vandermeer on LinkedIn (opens in a new tab)">Connect on LinkedIn ↗</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-hero { padding: clamp(4.5rem, 10vw, 8.5rem) 0 clamp(5rem, 11vw, 9rem); overflow: hidden; }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(360px,.92fr); gap:clamp(3rem,7vw,7rem); align-items:center; }
  .hero-copy h1 { max-width:730px; margin-bottom:2rem; }
  .hero-lede { max-width:680px; color:var(--deep-ink); font-size:clamp(1.2rem,2vw,1.48rem); line-height:1.55; }
  .portrait-composition { width:min(100%,620px); justify-self:center; }
  .portrait-frame { margin:0; }
  .portrait-frame img { display:block; width:100%; height:auto; }
  .narrative-section { padding:clamp(5rem,10vw,9rem) 0; border-block:1px solid rgba(18,58,55,.11); }
  .narrative-grid { display:grid; grid-template-columns:1fr 3fr; gap:3rem; }
  .section-marker { color:var(--signal-coral); font-weight:800; letter-spacing:.12em; }
  .narrative-copy { max-width:850px; }
  .narrative-copy p { font-size:clamp(1.08rem,1.6vw,1.28rem); line-height:1.8; }
  .narrative-copy .opening { color:var(--deep-ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.55rem,3vw,2.35rem); line-height:1.38; }
  .topics-section { padding:clamp(5rem,10vw,9rem) 0; }
  .topics-intro { max-width:720px; margin-bottom:3.5rem; }
  .topics-intro h2 { margin-bottom:1.4rem; }
  .topics-intro > p:last-child { font-size:1.12rem; }
  .topic-grid { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(2,1fr); border-top:1px solid rgba(18,58,55,.18); }
  .topic-grid li { min-height:190px; padding:1.6rem 2rem 2rem 0; border-bottom:1px solid rgba(18,58,55,.18); display:grid; grid-template-columns:52px 1fr; gap:1.2rem; }
  .topic-grid li:nth-child(odd) { border-right:1px solid rgba(18,58,55,.18); }
  .topic-grid li:nth-child(even) { padding-left:2rem; }
  .topic-grid span { color:var(--ocean-teal); font-size:.75rem; font-weight:800; letter-spacing:.12em; }
  .topic-grid p { color:var(--deep-ink); font-size:clamp(1.08rem,1.8vw,1.35rem); line-height:1.45; }
  .editorial-note { max-width:800px; margin:3.5rem 0 0 auto; padding-left:1.5rem; border-left:4px solid var(--signal-coral); color:var(--deep-ink); font-family:Georgia,'Times New Roman',serif; font-size:clamp(1.25rem,2.5vw,1.7rem); }
  .editorial-note em { color:var(--ocean-teal); }
  .personal-section { padding:clamp(5rem,10vw,8rem) 0; background:var(--mist); }
  .personal-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(3rem,8vw,8rem); }
  .personal-heading h2 { max-width:520px; }
  .personal-copy { max-width:690px; padding-top:2.5rem; }
  .personal-copy > p { font-size:clamp(1.05rem,1.6vw,1.2rem); }
  .interest-labels { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:2.4rem; }
  .interest-labels span { padding:.55rem .8rem; border:1px solid rgba(18,58,55,.22); border-radius:999px; color:var(--deep-ink); font-size:.7rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .personal-graphic { width:180px; height:90px; margin-top:3rem; display:flex; align-items:flex-end; gap:10px; }
  .personal-graphic span { display:block; width:48px; background:var(--ocean-teal); }
  .personal-graphic span:nth-child(1) { height:42px; border-radius:50% 50% 0 0; }
  .personal-graphic span:nth-child(2) { height:74px; background:var(--signal-coral); }
  .personal-graphic span:nth-child(3) { height:58px; background:var(--digital-blue); border-radius:0 28px 0 0; }
  .connect-section { padding:clamp(5rem,10vw,8rem) 0; background:var(--deep-ink); }
  .connect-grid { display:grid; grid-template-columns:1fr 3fr; gap:3rem; }
  .connect-section .eyebrow { color:var(--sea-glass); }
  .connect-section h2 { max-width:850px; margin-bottom:2.2rem; color:var(--white); font-size:clamp(2rem,4vw,3.4rem); }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media (max-width:900px) { .hero-grid,.personal-grid { grid-template-columns:1fr; } .narrative-grid,.connect-grid { grid-template-columns:1fr; gap:1.25rem; } .personal-copy { padding-top:0; } }
  @media (max-width:640px) { .about-hero { padding-top:4rem; } .topic-grid { grid-template-columns:1fr; } .topic-grid li,.topic-grid li:nth-child(even) { min-height:0; padding:1.5rem 0; border-right:0; } }
</style>
