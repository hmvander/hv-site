---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Ideas | Heidi Vandermeer" canonical="https://heidivandermeer.com/ideas">
  <Header />
  <main class="placeholder-page">
    <div class="container">
      <p class="eyebrow">Ideas</p>
      <h1>Ideas, frameworks, and experiments.</h1>
      <p>This section is coming soon. It will include writing and experiments on B2B growth, AI, marketing systems, and leadership.</p>
      <a class="text-link" href="/">← Back home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
<style>
.placeholder-page { min-height:70vh; display:grid; align-items:center; padding:100px 0; }
.placeholder-page .container { max-width:900px; }
.placeholder-page h1 { max-width:800px; }
.placeholder-page p:not(.eyebrow) { max-width:680px; font-size:1.16rem; }
</style>
